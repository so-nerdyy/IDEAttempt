{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "out",
    "sourceMap": true,
    "skipLibCheck": true,
    "paths": {
      "@kilocode/sdk": ["./packages/sdk/src"],
      "@kilocode/sdk/*": ["./packages/sdk/src/*"],
      "@kilocode/kilo-i18n": ["./packages/kilo-i18n/src"],
      "@kilocode/kilo-i18n/*": ["./packages/kilo-i18n/src/*"],
      "@kilocode/kilo-ui/*": ["./packages/kilo-ui/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "packages/sdk/**/*.ts",
    "../../src/vscode-dts/vscode.d.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules/bun-types",
    "node_modules/@types/mdx",
    "out",
    "dist",
    "packages/sdk/node_modules",
    "packages/sdk/dist",
    "packages/sdk/test",
    "packages/sdk/example",
    "packages/sdk/script",
    "packages/kilo-gateway",
    "packages/kilo-i18n",
    "packages/kilo-telemetry",
    "packages/kilo-ui",
    "packages/opencode"
  ]
}
